# Copy to .env.local and fill in. .env.local is git-ignored.
# Quick-log AI (server-side only; never exposed to the browser)
HKBU_GENAI_API_KEY=
HKBU_GENAI_BASE_URL=https://genai.hkbu.edu.hk/api/v1
HKBU_GENAI_MODEL=gpt-6-luna

